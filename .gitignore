# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.\#*
\#*\#

# --- Claude Code / local agent state ---
# Local, machine-specific permission overrides — never share.
.claude/settings.local.json
.claude/*.local.json
CLAUDE.local.md
# Worktree scratch dirs (generated per session)
.claude/worktrees/

# --- spec-kit working state ---
# Feature working dirs are generated per-run; commit deliberately, not by default.
specs/*/
!specs/*/spec.md
!specs/*/plan.md
!specs/*/tasks.md

# --- spec-kit generated/cache ---
# Catalog HTTP cache — regenerated on every specify search/add.
.specify/extensions/.cache/
.specify/presets/.cache/
# Dev-install staging dirs (only present when using --dev; not for distribution).
.specify/extensions/*/.specify-dev/

# --- Scala / sbt (future compiled helper-lib, per CLAUDE.md) ---
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
.scala-build/

# --- JVM / build ---
*.class
*.log
hs_err_pid*

# --- Node (if tooling lands here) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Python (if tooling lands here) ---
__pycache__/
*.py[cod]
.venv/
venv/
.env

# --- Secrets / env ---
.env.local
*.pem
*.key
secrets.*

# Spec Kit: Python caches and the CLI state, which the kit does not ship (scripts/check-speckit.sh)
.specify/extensions/.registry
.specify/extensions/.backup/
.specify/presets/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json
